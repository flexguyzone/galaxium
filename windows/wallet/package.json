{
  "name": "galaxium-wallet",
  "version": "1.0.0",
  "description": "Galaxium Wallet for Windows",
  "main": "main.js",
  "author": "Galaxium",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.galaxium.wallet",
    "productName": "Galaxium Wallet",
    "files": ["main.js"],
    "win": { "target": ["nsis"], "artifactName": "Galaxium-Wallet-Setup.exe" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Galaxium Wallet"
    }
  }
}